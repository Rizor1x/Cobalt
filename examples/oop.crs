// 2. ТЕСТИРУЕМ КЛАССЫ!
class Voxel {
    // Поля (переменные класса)
    val x: int
    val y: int
    val z: int
    var id: int

    // Метод (функция внутри класса)
    fn is_air(self) -> bool {
        // Если ID == 0, значит это воздух
        return self.id == 0
    }
}