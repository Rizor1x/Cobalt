// 1. Тест функций и математики
fn multiply(a: int, b: int) -> int {
    return a * b
}

print("=== CREST OS: ИНИЦИАЛИЗАЦИЯ ===")

// 2. Тест ВВОДА ДАННЫХ (input)
val user = input("Введите ваше имя: ")

// 3. Тест логики и условий
if user == "Rizor1x" {
    print("С возвращением, Создатель!")
} else {
    print("Приветствую, пользователь:")
    print(user)
}

// 4. Тест динамических списков (векторов)
print("---")
var numbers = [10, 20, 30]
print("Создан массив из 3 элементов. Начинаем добавление...")

// 5. Тест цикла While и вызова методов массива
var count = 0
while count < 2 {
    numbers.push(100) // Вызываем метод Rust напрямую!
    count = count + 1
}

// 6. Тест получения свойств
val length: int = numbers.len()
print("Новая длина массива:")
print(length)

// 7. Тест цикла For, диапазонов и вызова наших функций
print("---")
print("Умножаем индексы на 10:")
for i in 0 .. length {
    val result = multiply(i, 10)
    print(result)
}

print("=== ТЕСТ УСПЕШНО ПРОЙДЕН ===")