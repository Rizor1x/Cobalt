val limit: int = 5
var count = 0
val float_val: float = 3.14

print("--- Start ---")

// Тест логики и условий
if count < limit and float_val > 3.0 {
    print("Logic works!")
} else {
    print("Logic broken!")
}

// Тест циклов и математики
print("--- While Loop ---")
while count < 3 {
    print(count)
    count = count + 1
}

// Тест цикла for и диапазонов
print("--- For Loop ---")
for i in 0 .. 3 {
    val res = i * 2
    print(res)
}