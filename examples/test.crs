val limit: int = 5
var count = 0
val float_val: float = 3.14

print("--- Start ---")

// Тест логики и условий
if count < limit and float_val > 3.0 {
    print("Logic works!")
} else {
    print("Logic broken!")
}

// Тест циклов и математики
print("--- While Loop ---")
while count < 3 {
    print(count)
    count = count + 1
}

// Тест цикла for и диапазонов
print("--- For Loop ---")
for i in 0 .. 3 {
    val res = i * 2
    print(res)
}

// Функция, которая складывает два числа
fn add(a: int, b: int, c: int) -> int {
    val result: int = a + b + c
    return result
}

// Функция без возврата (просто печатает)
fn greet(name: str) {
    print("Hello from Crest!")
    print(name)
}

print("--- Тест функций ---")

// Вызываем наши функции!
val sum = add(10, 5, 10)
print("Сумма 10, 5 и 10:")
print(sum)

greet("Rizor1x")